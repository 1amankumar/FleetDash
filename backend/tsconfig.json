{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/workers/telemetry.worker.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}